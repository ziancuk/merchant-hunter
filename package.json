{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "test": "vitest run",
        "lint": "eslint resources tests/e2e --max-warnings=0",
        "lint:fix": "eslint resources tests/e2e --fix",
        "e2e": "playwright test",
        "typecheck": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@inertiajs/vue3": "^2.3.29",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^5.0.5",
        "@vue/test-utils": "^2.5.1",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^10.13.0",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^3.2.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^7.0.7",
        "vitest": "^5.0.5",
        "vue": "^3.5.44",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.13",
        "wait-on": "^9.5.1"
    },
    "dependencies": {
        "@deck.gl/maplibre": "^9.4.0",
        "@luma.gl/core": "~9.4.0",
        "@luma.gl/engine": "~9.4.0",
        "deck.gl": "^9.4.0",
        "maplibre-gl": "^6.15.0"
    }
}
